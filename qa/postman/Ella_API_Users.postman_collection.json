          }
        },
        {
          "name": "TC-USR-04: Update User (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('User updated successfully', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.name).to.eql('Updated User Name');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated User Name\",\n  \"email\": \"{{createdUserEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{createdUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{createdUserId}}"
              ]
            }
          }
        }
      ]
    }
  ]
