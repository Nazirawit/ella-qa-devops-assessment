{
  "info": {
    "_postman_id": "a918b9ec-b01f-4ef6-9f4a-874fa77e2026",
    "name": "Ella API — Test Suite",
    "description": "",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "createdUserId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "createdUserEmail",
      "value": "qa.test@example.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users Module",
      "item": [
        {
          "name": "TC-USR-01: Create User (Happy Path)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomId = Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set('createdUserEmail', `user_${randomId}@example.com`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains valid created user data', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.statusCode).to.eql(201);",
                  "    pm.expect(json.data).to.be.an('object');",
                  "    pm.expect(json.data.id).to.be.above(0);",
                  "    pm.expect(json.data.email).to.eql(pm.collectionVariables.get('createdUserEmail'));",
                  "    pm.collectionVariables.set('createdUserId', json.data.id.toString());",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{createdUserEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "TC-USR-05: Create Duplicate User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"{{createdUserEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
